{
  "name": "vtubervn-plus",
  "version": "2.0.2",
  "description": "VtuberVN★ Companion Extension (V2) - Enhanced YouTube Stream Viewing on VtuberVN.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VtuberVN/VtuberVN-Plus-ext-v2.git"
  },
  "scripts": {
    "build": "yarn build:chrome && yarn build:firefox",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "pack": "node scripts/pack.js",
    "package": "node scripts/pack.js",
    "package:prod": "node scripts/pack.js",
    "package:local": "node scripts/pack.js --local",
    "package:all": "node scripts/pack.js --all",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:firefox": "nodemon --config nodemon.firefox.json"
  },
  "type": "module",
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "protoframe": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "signal-promise": "^1.0.3",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0",
    "youtubei.js": "^12.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^20.12.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.5",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "chrome-types": "^0.1.320",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fs-extra": "^11.2.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "7.1.11",
    "vite-tsconfig-paths": "^6.0.3"
  }
}
